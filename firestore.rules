rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isLordDemonAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'epargnelock@gmail.com' || 
        request.auth.token.admin == true || 
        request.auth.uid == 'dev_lord_demon'
      );
    }

    // Projects collection
    match /projects/{projectId} {
      // Anyone can read public projects
      allow read: if true;
      
      // Only authenticated users can create new projects under their own ID
      allow create: if isAuthenticated() 
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
                    
      // Project owner or admin can update full project; or atomic counter increments & unique viewers/downloaders
      allow update: if isOwner(resource.data.ownerId) 
                    || isLordDemonAdmin()
                    || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'views', 'downloadedBy', 'viewedBy'])
                       );
                       
      // Only project owner or admin can delete project
      allow delete: if isOwner(resource.data.ownerId) 
                    || isLordDemonAdmin() 
                    || (isAuthenticated() && request.auth.token.email == resource.data.ownerEmail);
    }
    
    // Moderation & Reports collection
    match /reports/{reportId} {
      // Authenticated users can submit a report
      allow create: if isAuthenticated();
      
      // Only administrators can read, review, or delete reports
      allow read, update, delete: if isLordDemonAdmin();
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) || isLordDemonAdmin();
      allow delete: if isLordDemonAdmin();
    }
  }
}

