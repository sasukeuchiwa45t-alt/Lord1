rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --------------------------------------------------------------------------
    // HELPER SECURITY FUNCTIONS
    // --------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Firebase Custom Claim or Verified Super-Admin
    function isLordDemonAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'epargnelock@gmail.com'
      );
    }

    // --------------------------------------------------------------------------
    // PROJECTS COLLECTION
    // --------------------------------------------------------------------------
    match /projects/{projectId} {
      // Unauthenticated or general users can read public/published projects;
      // Owners and Admins can also read unpublished/moderated projects
      allow read: if resource == null 
                  || resource.data.status == 'published' 
                  || !('status' in resource.data)
                  || isOwner(resource.data.ownerId) 
                  || isLordDemonAdmin();
      
      // Only authenticated users can create projects under their own verified Firebase Auth UID
      allow create: if isAuthenticated() 
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.createdAt is string
                    && (!('downloads' in request.resource.data) || request.resource.data.downloads == 0)
                    && (!('views' in request.resource.data) || request.resource.data.views == 0 || request.resource.data.views == 1);
                    
      // Project updates:
      // 1. Owner can update project details (ownerId and createdAt remain immutable)
      // 2. Admin can perform any update (status, featured, moderation)
      // 3. Counter increments can only touch stats fields
      allow update: if (
                        isOwner(resource.data.ownerId)
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.createdAt == resource.data.createdAt
                       )
                    || isLordDemonAdmin()
                    || (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'views', 'downloadedBy', 'viewedBy', 'updatedAt'])
                       );
                        
      // Strictly only the project owner (verified UID) or Admin can delete the project
      // Email or display names are strictly NOT accepted as proof of ownership
      allow delete: if isOwner(resource.data.ownerId) 
                    || isLordDemonAdmin();
    }
    
    // --------------------------------------------------------------------------
    // MODERATION & REPORTS COLLECTION
    // --------------------------------------------------------------------------
    match /reports/{reportId} {
      // Authenticated users can submit a report under their own UID with 'pending' status
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.projectId is string
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is string;
      
      // Standard users CANNOT view other reports, modify status, or delete reports
      // Only administrators can read, review, status-change, or delete reports
      allow read, update, delete: if isLordDemonAdmin();
    }
    
    // --------------------------------------------------------------------------
    // USERS COLLECTION
    // --------------------------------------------------------------------------
    match /users/{userId} {
      // Profiles are publicly readable for author credits and community view
      allow read: if true;
      
      // Users can create their own profile under their Auth UID, cannot self-grant admin
      allow create: if isOwner(userId)
                    && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false || isLordDemonAdmin());
      
      // Users can update their profile but cannot alter UID or self-escalate admin rights
      allow update: if (
                        isOwner(userId) 
                        && request.resource.data.uid == userId
                        && (
                          !('isAdmin' in request.resource.data) 
                          || request.resource.data.isAdmin == resource.data.isAdmin 
                          || isLordDemonAdmin()
                        )
                       )
                    || isLordDemonAdmin();
                    
      // Only Admin or the account owner can delete user profile
      allow delete: if isLordDemonAdmin() || isOwner(userId);
    }
  }
}


